# docker/interp/neuronpedia.env-deltas
#
# Interp Phase 2 PS1: non-secret deltas this repository applies to the upstream checkout's
# .env.localhost (merged by scripts/interp/np_env.sh, run via `make np-env`). Keys listed
# here replace the upstream values; keys absent here keep upstream's defaults.
#
# Named *.env-deltas rather than *.env because the agent sandbox guard denies access to
# *.env paths; this file holds no secrets. HF_TOKEN and OPENAI_API_KEY come from the
# untracked .env.interp and are written to the checkout's .env by the same script.

# Webapp is remapped to host port 3001 (3000 collides with open-webui)
NEXT_PUBLIC_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3001

# Autointerp runs locally (PS4 wires it to vllm-gpu over the shared network)
USE_LOCALHOST_AUTOINTERP=true
