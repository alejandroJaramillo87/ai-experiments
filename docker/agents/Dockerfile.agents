# Dockerfile.agents
#
# Containment image for coding agents (OpenCode + Claude Code). Unlike the
# inference services, an agent is a general-purpose mutator: it edits a repo,
# runs compilers, and installs packages. The security model is therefore
# OS-level isolation (see docs/sandbox/agent-sandbox.md), not the permission
# rules the CLIs enforce internally.
#
# Both CLIs are pinned to exact versions (pin, then bump deliberately). The
# image carries no GPU access and no host credentials; the single scoped key it
# needs is injected by the compose file at run time.

# uv is pulled from its own published image rather than a curl installer, so the
# version is pinned by digest-resolvable tag like every other image here. The ARG
# precedes the first FROM because a build arg used in a FROM must be declared in
# the global scope.
ARG UV_VERSION=0.11.28

# Rust arrives the same way and for the same reason: a published image pins the
# toolchain by tag instead of resolving whatever rustup serves that day. The tag
# is -slim-bookworm so the copied binaries link against the same Debian 12 glibc
# 2.36 the node base ships.
#
# 1.88.0 matches the workstation (rustc 1.88.0, cargo 1.88.0), so a sandbox gate
# result means what a workstation result means. Kept in step with
# rust-harness/rust-toolchain.toml. The workspace's declared minimum is 1.87,
# where the integer `is_multiple_of` stabilized; the pin is deliberately the
# host's version rather than that floor.
#
# This ARG sits above every FROM for the reason given above: a build arg used in
# a FROM must be declared in the global scope, or it expands to empty and the
# stage name is invalid.
ARG RUST_VERSION=1.88.0

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv-source

FROM rust:${RUST_VERSION}-slim-bookworm AS rust-source

# The official image uses the minimal rustup profile, which ships neither clippy
# nor rustfmt. `make quality` runs both, plus rustdoc.
RUN rustup component add clippy rustfmt

# Resolve the workspace's dependency graph at build time so the gate stays offline
# at run time, as /work/AGENTS.md claims of it. Only the manifests are copied, so
# this layer rebuilds when Cargo.lock changes and not when source does. cargo needs
# each member's target file to exist before it will parse the manifest, hence the
# stubs; they are discarded with this stage.
ENV CARGO_HOME=/opt/cargo
WORKDIR /build
COPY rust-harness/Cargo.toml rust-harness/Cargo.lock ./
COPY rust-harness/harness/Cargo.toml harness/Cargo.toml
COPY rust-harness/runtime/Cargo.toml runtime/Cargo.toml
RUN mkdir -p harness/src runtime/src \
    && printf 'fn main() {}\n' > harness/src/main.rs \
    && printf '' > runtime/src/lib.rs \
    && cargo fetch --locked \
    && rm -rf /opt/cargo/registry/src

# Pinned base. node:22 is the current LTS line; bump deliberately per the
# repo's pin-then-update rule.
FROM node:22.14.0-bookworm-slim

# Exact CLI pins. Resolved against the npm registry at implementation time;
# both match the host install (opencode 1.17.18, claude-code 2.1.207).
ARG OPENCODE_VERSION=1.17.18
ARG CLAUDE_CODE_VERSION=2.1.212

# Language-server pin (Python symbol navigation for both CLIs).
ARG PYRIGHT_VERSION=1.1.411

# Python toolchain pins. uv matches the workstation (uv self version -> 0.11.28)
# so the sandbox and the host resolve dependencies identically. The interpreter
# matches the workstation's 3.12.11 and satisfies pyproject.toml's
# requires-python = ">=3.12,<3.13"; ruff and mypy are the exact pins from
# pyproject.toml's dev group, so a sandbox lint result means the same thing as
# `make quality` does on the host.
ARG PYTHON_VERSION=3.12.11
ARG RUFF_VERSION=0.15.21
ARG MYPY_VERSION=2.3.0
ARG TYPES_PYYAML_VERSION=6.0.12.20250915

# Runtime tools the agents shell out to. git is required for the worktree
# workflow; curl/ca-certificates support egress and the acceptance checks.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        curl \
        ca-certificates \
        jq \
        ripgrep \
        shellcheck \
        make \
        gcc \
        libc6-dev \
    && rm -rf /var/lib/apt/lists/*

# Install both CLIs globally at the pinned versions.
RUN npm install -g --no-fund --no-audit \
        "opencode-ai@${OPENCODE_VERSION}" \
        "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
        "pyright@${PYRIGHT_VERSION}" \
    && npm cache clean --force

# Python toolchain. Without it an agent cannot syntax-check its own edits, so
# every Python change round-trips through the workstation for its first check.
#
# The runtime rootfs is read-only and $HOME is a 256MB tmpfs (see
# docker-compose.agents.yaml), so every path uv writes to is pinned here: the
# interpreter and tool venvs live under /opt (baked into the image), the cache
# under /tmp (the writable tmpfs), and tool shims on the default PATH.
#
# This does NOT substitute for `make quality` on the workstation: `make test`
# reaches the pytorch cu130 index, and an unsynced .venv resolves different
# versions than the lockfile pins. It provides fast local feedback, not proof.
COPY --from=uv-source /uv /usr/local/bin/uv

ENV UV_PYTHON_INSTALL_DIR=/opt/uv/python \
    UV_TOOL_DIR=/opt/uv/tools \
    UV_TOOL_BIN_DIR=/usr/local/bin \
    UV_PYTHON_BIN_DIR=/usr/local/bin \
    UV_CACHE_DIR=/tmp/uv-cache

RUN uv python install "${PYTHON_VERSION}" --default --preview \
    && uv tool install "ruff==${RUFF_VERSION}" \
    && uv tool install "mypy==${MYPY_VERSION}" \
        --with "types-pyyaml==${TYPES_PYYAML_VERSION}" \
    && chmod -R a+rX /opt/uv \
    && rm -rf /tmp/uv-cache

# numpy and gguf are not optional extras: the rust gate hard-depends on them.
# runtime/src/npz.rs shells out to python3 to re-read a written shard with
# np.load, so `cargo test` FAILS outright without numpy rather than skipping,
# and the cross-language contract tests need gguf to exercise the real Python
# exporters. Both are the exact pins from pyproject.toml, so a sandbox result
# means what a workstation result means. They live in their own venv placed
# first on PATH, leaving the ruff and mypy tool venvs above untouched.
#
# The rest of the list is the `sandbox` dependency group from pyproject.toml
# verbatim, plus pytest from the `dev` group and safetensors. Installing the
# declared group rather than a hand-picked subset is deliberate: "sandbox tier"
# then has one definition someone can review against pyproject.toml, and
# /work/AGENTS.md's "~4 skips, not ~40" heuristic depends on knowing exactly
# what is present. Without pytest here no Python test runs in a sandbox at all,
# which pushes an agent into building a venv on the bind-mounted worktree --
# writable, executable, and visible to the host, which is the pressure the
# read-only rootfs exists to remove.
#
# numpy is pinned explicitly alongside the group so a transitive requirement
# (scikit-learn's, in particular) cannot silently resolve it downward. A
# conflict fails the build rather than producing an image whose rust gate is
# subtly wrong.
ARG NUMPY_VERSION=2.4.6
ARG GGUF_VERSION=0.19.0
RUN uv venv --python "${PYTHON_VERSION}" /opt/pyenv \
    && uv pip install --python /opt/pyenv/bin/python \
        "numpy==${NUMPY_VERSION}" \
        "gguf==${GGUF_VERSION}" \
        "omegaconf==2.3.1" \
        "hydra-core==1.3.2" \
        "pyyaml==6.0.3" \
        "xxhash==3.5.0" \
        "tokenizers==0.22.2" \
        "scikit-learn==1.9.0" \
        "fastapi==0.139.0" \
        "httpx==0.28.1" \
        "uvicorn==0.51.0" \
        "requests==2.34.2" \
        "safetensors==0.8.0" \
        "pytest==9.1.1" \
        "pytest-asyncio==1.4.0" \
        "pytest-mock==3.15.1" \
        "pytest-xdist==3.8.0" \
        "pytest-cov==7.1.0" \
    && chmod -R a+rX /opt/pyenv \
    && rm -rf /tmp/uv-cache
ENV PATH=/opt/pyenv/bin:$PATH

# Rust toolchain and the prefetched crate registry from the builder stage.
COPY --from=rust-source /usr/local/rustup /usr/local/rustup
COPY --from=rust-source /usr/local/cargo /usr/local/cargo
COPY --from=rust-source /opt/cargo /opt/cargo
ENV RUSTUP_HOME=/usr/local/rustup \
    PATH=/usr/local/cargo/bin:$PATH

# CARGO_HOME must be writable and cannot live on the rootfs, which is read-only
# at run time, nor in $HOME, a 256MB tmpfs. /tmp is the 1GB tmpfs. The seed below
# copies the baked registry there once per session; /etc/profile.d is sourced
# because the make wrapper launches a login shell (`sh -lc`). A session that
# somehow skips it still works — cargo falls back to fetching from crates.io,
# which the proxy allowlists — it is merely slower.
ENV CARGO_HOME=/tmp/cargo
RUN printf '%s\n' \
    'if [ ! -d "$CARGO_HOME" ]; then' \
    '  mkdir -p "$CARGO_HOME" && cp -a /opt/cargo/. "$CARGO_HOME"/ 2>/dev/null || true' \
    'fi' \
    > /etc/profile.d/cargo-home.sh \
    && chmod 0644 /etc/profile.d/cargo-home.sh

# Restore the image's PATH under a login shell.
#
# The ENV PATH lines above are correct for a non-login invocation, but the make
# wrapper launches `sh -lc` (Makefile: agent-sandbox), and Debian's /etc/profile
# assigns PATH unconditionally rather than defaulting it:
#
#   PATH="/usr/local/bin:/usr/bin:/bin:/usr/local/games:/usr/games"
#
# That discards /opt/pyenv/bin and /usr/local/cargo/bin, so a session had no
# cargo at all -- `cd rust-harness && make quality` could not run, though
# /work/AGENTS.md and .styles/RUST_STYLE.md both state that it does -- and
# python3 resolved to the bare /usr/local/bin interpreter, which carries no
# numpy, so runtime/src/npz.rs would fail rather than skip. ruff, mypy, and
# shellcheck survived only by happening to sit in the default PATH, which is
# what made the breakage look like a missing toolchain rather than a lost PATH.
#
# profile.d is sourced after that assignment, so prepending here wins. Keep both
# mechanisms: ENV for non-login invocations, this for login shells.
RUN printf '%s\n' \
    'PATH="/opt/pyenv/bin:/usr/local/cargo/bin:$PATH"' \
    'export PATH' \
    > /etc/profile.d/10-agent-path.sh \
    && chmod 0644 /etc/profile.d/10-agent-path.sh

# Native LSP tool in Claude Code (symbol navigation instead of grep sweeps);
# pyright above serves both CLIs.
ENV ENABLE_LSP_TOOL=1

# Disable the Claude Code auto-updater inside the image; version currency is
# managed by rebuilding against a new pin, not by in-place self-update.
ENV DISABLE_AUTOUPDATER=1

# Route all egress through the proxy sidecar. This is defense in depth only:
# the real enforcement is the internal:true network in the compose file, which
# leaves the container no route to the internet except the proxy. The env vars
# simply tell well-behaved HTTP clients where that proxy is.
ENV HTTP_PROXY=http://agent-proxy:3128 \
    HTTPS_PROXY=http://agent-proxy:3128 \
    http_proxy=http://agent-proxy:3128 \
    https_proxy=http://agent-proxy:3128 \
    NO_PROXY=localhost,127.0.0.1,agent-proxy \
    no_proxy=localhost,127.0.0.1,agent-proxy

# Sandbox-only OpenCode config: autoupdate off (the image is the pinned unit of
# currency). The host copy keeps updates on, where staleness is the larger risk.
# It lives on the (read-only) rootfs and is selected via OPENCODE_CONFIG, so the
# agent's home directory can be an ephemeral tmpfs at run time.
COPY docker/agents/opencode.sandbox.json /etc/opencode/opencode.json
ENV OPENCODE_CONFIG=/etc/opencode/opencode.json

# Non-root user. The node base image already ships a `node` user at uid 1000,
# which matches the host user that owns the bind-mounted worktree, so writes to
# the worktree work without root. Reuse it rather than add a duplicate uid.
USER node
WORKDIR /work

# No ENTRYPOINT: the compose file / make wrapper supplies the CLI invocation so
# one image serves both tools.
CMD ["bash"]
