# Export Dockerfile - the merged HF checkpoint exporter
#
# Separate from Dockerfile.training by design decision: the image that trains a model is
# not reused to prepare it for serving. This image carries only what the export needs: a
# CPU-only Python stack for the PEFT adapter merge and the safetensors write. No GPU, no
# CUDA base: merging is CPU-bound and must not compete with a serving swap for VRAM.
#
# The export writes an HF checkpoint directory (config.json plus one model.safetensors)
# that the rust harness serves and interp captures from. It produces no GGUF: that is
# llama.cpp's format and appears in this repository only as published models.

ARG UV_VERSION=0.11.28

# Pinned uv binary source (matches docker/training/Dockerfile.training)
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM ubuntu:24.04

LABEL description="Merged HF checkpoint exporter: CPU-only adapter merge and safetensors write"

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# python for the adapter merge; git for the manifest's git_sha
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        ca-certificates \
        python3.12 \
        python3.12-dev \
        python3.12-venv && \
    rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /uvx /usr/local/bin/

RUN uv venv /opt/venv --python 3.12
ENV VIRTUAL_ENV="/opt/venv"
ENV PATH="/opt/venv/bin:${PATH}"

# CPU-only Python stack for the adapter merge. Versions mirror the core pins in
# pyproject.toml (transformers/peft/accelerate/sentencepiece); torch uses the CPU wheel
# index because the cu130 build in uv.lock is GPU-sized and unnecessary here — this is the
# one deliberate deviation from lockfile installs, kept in sync by hand with pyproject.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --index-url https://download.pytorch.org/whl/cpu torch==2.13.0 && \
    uv pip install \
        transformers==5.13.1 \
        peft==0.19.1 \
        accelerate==1.14.0 \
        sentencepiece==0.2.2

# Non-root user (repo-standard line, matches the inference images)
RUN groupadd -r appuser && useradd -r -g appuser -d /app -s /sbin/nologin -c "Application User" appuser

ENV HF_HOME=/app/cache
ENV HOME=/app
RUN mkdir -p /app/cache /app/logs && chown -R appuser:appuser /app

WORKDIR /app
USER appuser

# Sanity check: the python stack imports
RUN python -c "import torch, transformers, peft, safetensors"

CMD ["/bin/bash"]
