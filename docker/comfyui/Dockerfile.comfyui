# Stage 1: Builder
# CUDA 13.0 development environment matching host driver 580.65.06 / CUDA 13.0.88
FROM nvidia/cuda:13.0.0-devel-ubuntu24.04 AS builder

LABEL stage="builder"

# Build environment setup
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
# RTX 5090 Blackwell architecture
ENV TORCH_CUDA_ARCH_LIST="12.0"
ENV CUDA_ARCHITECTURES=120
ENV CUDA_DOCKER_ARCH=sm_120

# Install build dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
        python3-pip \
        build-essential \
        cmake \
        ninja-build \
        ca-certificates \
        curl && \
    rm -rf /var/lib/apt/lists/*

# Clone ComfyUI release v0.27.1 (native FLUX.2, Wan 2.2, and LTX video nodes)
RUN git clone --depth 1 --branch v0.27.1 \
    https://github.com/comfyanonymous/ComfyUI.git /app

WORKDIR /app

# Create virtual environment and install core dependencies.
# torch 2.9.1+cu130 matches the CUDA 13.0 base image and Blackwell sm_120;
# torchvision/torchaudio are the matched companion releases for torch 2.9.1.
# av provides the ffmpeg bindings ComfyUI uses to encode video outputs.
# Direct installs are pinned exactly; where the repo core pins the same
# package (transformers, accelerate, sentencepiece, huggingface-hub) the pin
# is reused. ComfyUI's own requirements.txt comes from the tag-pinned
# checkout above; freezing its transitive resolution needs a workstation
# build (same validation pass as the node-pin TODO below).
RUN python3.12 -m venv venv && \
    . venv/bin/activate && \
    pip install pip==26.1.2 wheel==0.47.0 setuptools==83.0.0 && \
    pip install torch==2.9.1 torchvision==0.24.1 torchaudio==2.9.1 --index-url https://download.pytorch.org/whl/cu130 && \
    pip install -r requirements.txt && \
    pip install diffusers==0.39.0 transformers==5.13.1 accelerate==1.14.0 \
        sentencepiece==0.2.2 protobuf==7.35.1 huggingface-hub==1.23.0 av==18.0.0

# Install ComfyUI Manager and model-format custom nodes.
# Pin each node to an exact commit: ComfyUI loads and executes this code, and
# ComfyUI-Manager can fetch further nodes at runtime. Bump deliberately, not on rebuild.
# TODO: Bump node pins after validating against ComfyUI v0.27.1 on the workstation;
# ComfyUI-GGUF in particular needs a recent commit for FLUX.2 and LTX GGUF quants.
ARG COMFYUI_MANAGER_COMMIT=351d9c62c419bf49c0fdb6a5a378e94dc3481193
ARG COMFYUI_GGUF_COMMIT=6ea2651e7df66d7585f6ffee804b20e92fb38b8a
ARG COMFYUI_KJNODES_COMMIT=e27a505b3ba6ce42687fe00500deda103d9d6071
ARG COMFYUI_TOOLING_COMMIT=5d3194f4d4158ab31df7a060e1e4c56fa03f320c
WORKDIR /app/custom_nodes
RUN git clone https://github.com/ltdrdata/ComfyUI-Manager.git && \
    git -C ComfyUI-Manager checkout "${COMFYUI_MANAGER_COMMIT}" && \
    git clone https://github.com/city96/ComfyUI-GGUF.git && \
    git -C ComfyUI-GGUF checkout "${COMFYUI_GGUF_COMMIT}" && \
    git clone https://github.com/kijai/ComfyUI-KJNodes.git && \
    git -C ComfyUI-KJNodes checkout "${COMFYUI_KJNODES_COMMIT}" && \
    git clone https://github.com/Acly/comfyui-tooling-nodes.git && \
    git -C comfyui-tooling-nodes checkout "${COMFYUI_TOOLING_COMMIT}"

# Install custom node dependencies
WORKDIR /app
RUN . venv/bin/activate && \
    if [ -f custom_nodes/ComfyUI-Manager/requirements.txt ]; then \
        pip install -r custom_nodes/ComfyUI-Manager/requirements.txt; \
    fi && \
    if [ -f custom_nodes/ComfyUI-KJNodes/requirements.txt ]; then \
        pip install -r custom_nodes/ComfyUI-KJNodes/requirements.txt; \
    fi && \
    pip install gguf==0.19.0 opencv-python-headless==5.0.0.93 gitpython==3.1.52

# Stage 2: Runtime
FROM nvidia/cuda:13.0.0-runtime-ubuntu24.04

LABEL description="ComfyUI v0.27.1 for AI image and video generation (FLUX.2, Wan 2.2, LTX-2.3)"

# Install runtime dependencies only; ffmpeg backs video output encoding
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3.12 \
        python3.12-venv \
        libgomp1 \
        ca-certificates \
        curl \
        git \
        ffmpeg \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender1 && \
    rm -rf /var/lib/apt/lists/*

# CUDA runtime environment
ENV PATH=/usr/local/cuda/bin:${PATH}
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}
ENV CUDA_MODULE_LOADING=LAZY
ENV CUDA_DEVICE_ORDER=FASTEST_FIRST
ENV CUDA_VISIBLE_DEVICES=0

# Performance tuning for RTX 5090
ENV CUDA_LAUNCH_BLOCKING=0
ENV CUDNN_LOGINFO_DBG=0
ENV CUDA_CACHE_DISABLE=0
ENV CUDA_CACHE_PATH=/tmp/cuda_cache
ENV CUDA_FORCE_PTX_JIT=0

# NVIDIA GPU settings
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV NVIDIA_REQUIRE_CUDA="cuda>=13.0"

# Python environment
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Create non-root user
RUN groupadd -r appuser && \
    useradd -r -g appuser -d /app -s /sbin/nologin -c "ComfyUI User" appuser

# Copy application from builder
COPY --from=builder --chown=appuser:appuser /app /app

# Copy entrypoint script
COPY --chown=appuser:appuser docker/comfyui/entrypoint.sh /app/entrypoint.sh

# Set permissions and create writable directories
RUN chmod +x /app/entrypoint.sh && \
    mkdir -p /tmp/cuda_cache && \
    chown -R appuser:appuser /tmp/cuda_cache && \
    mkdir -p /app/user/default /app/.cache /app/temp /app/input && \
    chown -R appuser:appuser /app/user /app/.cache /app/temp /app/input

# Switch to non-root user
USER appuser

WORKDIR /app

# Expose ComfyUI port
EXPOSE 8188

# Use entrypoint script
ENTRYPOINT ["/app/entrypoint.sh"]
