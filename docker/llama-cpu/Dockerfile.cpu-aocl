# --- Stage 1: The Builder ---
# EXPERIMENTAL: llama.cpp with ZenDNN backend (AOCL-DLP low-precision GEMM)
# plus zen5_optimizer hugepage preload and AOCL-LibMem preload.
# See docs/optimizations/experiments/aocl-llama-cpp.md
FROM python:3.12-slim AS builder

LABEL stage="builder"

# Build environment for AMD Zen 5 architecture
ENV DEBIAN_FRONTEND=noninteractive
ENV CFLAGS="-march=znver5 -mtune=znver5 -O3"
ENV CXXFLAGS="${CFLAGS}"
ENV CC=gcc-14
ENV CXX=g++-14
ENV LDFLAGS="-Wl,-O3 -Wl,--as-needed"

# Install build dependencies (gcc-14 from unstable for znver5 support)
RUN echo "deb http://deb.debian.org/debian unstable main" > /etc/apt/sources.list.d/sid.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        gcc-14 g++-14 build-essential cmake git curl \
        libssl-dev libomp-dev pkg-config && \
    rm -rf /var/lib/apt/lists/*

# Build zen5_optimizer library (hugepage support via LD_PRELOAD)
COPY hugepages/CMakeLists.txt /tmp/zen5_optimizer/
COPY hugepages/src/ /tmp/zen5_optimizer/src/
RUN cd /tmp/zen5_optimizer && \
    cmake -B build \
        -DCMAKE_C_COMPILER=gcc-14 \
        -DCMAKE_CXX_COMPILER=g++-14 \
        -DCMAKE_BUILD_TYPE=Release \
        -DENABLE_HUGEPAGES=ON \
        -DENABLE_DEBUG_PRINT=OFF && \
    cmake --build build --config Release -j$(nproc) && \
    cp build/libzen5_optimizer.so /tmp/libzen5_optimizer.so && \
    echo "Built libzen5_optimizer.so (hugepage optimization)"

# Build AOCL-LibMem (Zen-optimized memcpy/memset, LD_PRELOAD drop-in)
# ALMEM_DYN_DISPATCH selects the ISA path at load time (AVX-512 on Zen 5)
RUN git clone --depth 1 https://github.com/amd/aocl-libmem.git /tmp/aocl-libmem && \
    cd /tmp/aocl-libmem && \
    cmake -S . -B build \
        -D CMAKE_C_COMPILER=gcc-14 \
        -D CMAKE_BUILD_TYPE=Release \
        -D ALMEM_DYN_DISPATCH=Y && \
    cmake --build build -j$(nproc) && \
    find build -name "libaocl-libmem.so*" -exec cp -P {} /tmp/ \; && \
    echo "Built libaocl-libmem.so (AOCL-LibMem)"

# Build llama.cpp with ZenDNN backend and AVX-512 configuration.
# GGML_ZENDNN=ON auto-clones a pinned ZenDNN release and its dependencies
# (AOCL-DLP, oneDNN, LibXSMM, aocl-utils) at configure time.
RUN rm -rf /tmp/llama.cpp && \
    git clone --depth 1 https://github.com/ggerganov/llama.cpp.git /tmp/llama.cpp && \
    cd /tmp/llama.cpp && \
    mkdir build && cd build && \
    cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DGGML_CUDA=OFF \
        -DGGML_BLAS=OFF \
        -DGGML_ZENDNN=ON \
        -DGGML_NATIVE=ON \
        -DGGML_LTO=ON \
        -DGGML_AVX512=ON \
        -DGGML_AVX512_VBMI=ON \
        -DGGML_AVX512_VNNI=ON \
        -DGGML_AVX512_BF16=ON \
        -DGGML_BUILD_TESTS=OFF \
        -DGGML_BUILD_EXAMPLES=OFF \
        -DLLAMA_CURL=OFF && \
    cmake --build . --config Release -j$(nproc) && \
    echo "Built llama.cpp (ZenDNN backend, AVX-512 VNNI, hugepages via LD_PRELOAD)"

# Collect every shared library from the build tree (ggml backends plus
# ZenDNN and its dependencies land in different subdirectories)
RUN mkdir -p /tmp/runtime-libs && \
    find /tmp/llama.cpp/build -name "*.so*" -exec cp -Pn {} /tmp/runtime-libs/ \; && \
    ls -l /tmp/runtime-libs/


# --- Stage 2: The Final Runtime Image ---
FROM debian:unstable-slim

LABEL description="EXPERIMENTAL llama.cpp with ZenDNN/AOCL-DLP backend (AVX-512 + zen5_optimizer + AOCL-LibMem)"

# Runtime libraries only
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r appuser && useradd -r -g appuser -d /app -s /sbin/nologin -c "Application User" appuser

USER appuser
WORKDIR /app

# Copy server binary (renamed to 'server' for entrypoint compatibility)
COPY --from=builder --chown=appuser:appuser /tmp/llama.cpp/build/bin/llama-server /app/server
# Copy all binaries from bin/
COPY --from=builder --chown=appuser:appuser /tmp/llama.cpp/build/bin/* /app/
# Copy collected shared libraries (ggml, ZenDNN, AOCL-DLP dependencies)
COPY --from=builder --chown=appuser:appuser /tmp/runtime-libs/ /app/
# Copy preload libraries
COPY --from=builder --chown=appuser:appuser /tmp/libzen5_optimizer.so /app/
COPY --from=builder --chown=appuser:appuser /tmp/libaocl-libmem.so* /app/
COPY --chmod=755 --chown=appuser:appuser docker/llama-cpu/entrypoint.cpu-aocl.sh /app/entrypoint.sh

# Library path for llama.cpp shared libs
ENV LD_LIBRARY_PATH=/app

# OpenMP settings (OMP_NUM_THREADS set dynamically by entrypoint)
ENV OMP_PROC_BIND=spread
ENV OMP_PLACES=cores

EXPOSE 8006

ENTRYPOINT ["/app/entrypoint.sh"]
