{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".styles/*.md"],
  "permission": {
    "bash": {
      "rm -rf *": "deny",
      "nvidia-smi -r*": "deny",
      "cat *.env*": "deny",
      "* ~/.ssh/*": "deny",
      "* ~/.aws/*": "deny",
      "docker system prune*": "ask",
      "docker volume rm*": "ask",
      "git push*": "ask",
      "* /mnt/ai-data/models*": "ask",
      "*": "allow"
    },
    "edit": "allow",
    "webfetch": {
      "https://docs.runpod.io/*": "allow",
      "https://github.com/*": "allow",
      "https://raw.githubusercontent.com/*": "allow",
      "https://objects.githubusercontent.com/*": "allow",
      "https://code.claude.com/*": "allow",
      "https://docs.anthropic.com/*": "allow",
      "https://huggingface.co/*": "allow",
      "https://docs.vllm.ai/*": "allow",
      "https://developer.nvidia.com/*": "allow",
      "https://docs.nvidia.com/*": "allow",
      "https://docs.docker.com/*": "allow",
      "*": "ask"
    },
    "external_directory": "ask",
    "doom_loop": "deny"
  },
  "lsp": {
    "typescript": { "disabled": true },
    "pyright": {
      "command": ["pyright-langserver", "--stdio"],
      "extensions": [".py"]
    }
  },
  "formatter": {
    "black": { "command": ["black"], "extensions": [".py"] }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "share": "disabled"
}
