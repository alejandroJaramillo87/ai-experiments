{
  "env": {
    "ENABLE_LSP_TOOL": "1"
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(nvidia-smi*)",
      "Bash(make up*)",
      "Bash(make down*)",
      "Bash(make status*)",
      "Bash(make logs*)",
      "Bash(make shell-*)",
      "Read(**/.env*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(//mnt/ai-data/models/**)",
      "Write(//mnt/ai-data/models/**)"
    ],
    "allow": [
      "Bash(ruff format *)",
      "Bash(ruff check *)",
      "Bash(mypy*)",
      "Bash(shellcheck*)",
      "Bash(xargs shellcheck --severity=warning)",
      "Bash(pytest*)",
      "Bash(python3 -m pytest*)",
      "Bash(cargo fmt*)",
      "Bash(cargo clippy*)",
      "Bash(cargo test*)",
      "Bash(cargo metadata*)",
      "Bash(cargo doc*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git worktree list*)",
      "Bash(make worktree-*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "WebSearch",
      "WebFetch(domain:docs.runpod.io)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:objects.githubusercontent.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:huggingface.co)",
      "WebFetch(domain:ai.google.dev)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:docs.vllm.ai)",
      "WebFetch(domain:developer.nvidia.com)",
      "WebFetch(domain:docs.nvidia.com)",
      "WebFetch(domain:docs.docker.com)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(rm * /mnt/ai-data/models*)",
      "WebFetch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/agents/guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/agents/runpod-idle-check.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/agents/runpod-idle-check.sh"
          }
        ]
      }
    ]
  }
}
