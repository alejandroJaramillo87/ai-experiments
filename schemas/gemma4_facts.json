  "notes": {
    "authored_from_config_not_transcripts": "Every value here comes from the config.json bytes at the pinned revisions, verified by the git blob sha1 in \"revisions\". Transcribing from docs/models/gemma4-*.txt would make the transcript assertions circular.",
    "head_dim_is_two_different_fields": "HF head_dim is 256 and applies to sliding layers only. rust-harness Config::head_dim is loaded from GGUF gemma4.attention.key_length and holds 512, the global head dim. Compare against global_head_dim when reading the Rust field, never against head_dim.",
    "read_the_layer_types_array": "layer_types_full_attention_indices is explicit because E2B uses a period of 5 and the other three use 6. Computing the schedule from one stride constant is wrong on E2B.",
    "final_layer_is_always_full_attention": "Asserted for all four variants when this file was built.",
    "gguf_shapes_are_dimension_reversed": "projection_shapes uses safetensors/HF order [out, in]. GGUF stores the reverse. Reverse before comparing against docs/models/gemma4-gguf.txt.",
    "no_tensor_facts_for_12b_and_31b": "projection_shapes is absent for 12B and 31B by decision, not oversight. No checkpoint headers for those two have been collected, so any shape here would be a derivation presented as an observation. E2B and E4B shapes are derived from config and independently confirmed against the safetensors headers.",
    "num_kv_shared_layers_shares_cache_not_weights": "All layers carry their own k_proj and v_proj in the released E-series checkpoints. The absence of attn_k is not a shared-KV signature. See the open question in docs/models/gemma-4.md.",
    "intermediate_size_is_not_per_layer_truth_on_e2b": "use_double_wide_mlp is true only on E2B, where 20 of 35 layers are double-wide.",
    "gate_on_hidden_size_per_layer_input": "vocab_size_per_layer_input is 262144 on all four variants including 12B and 31B where per-layer embeddings are disabled. hidden_size_per_layer_input is the field that decides.",
    "rope_theta_10000_elsewhere_is_unrelated": "training/recipes/schema.py and training/models/model.py default rope_theta to 10000.0 for the from-scratch scratch model. That is not Gemma 4 and is not a reader of this contract.",
    "hidden_size_2304_is_wrong": "A width of 2304 appears across tests/interp, tests/training, training/calculator, and three training/recipes/interp YAML files. It matches no variant. E2B is 1536 and E4B is 2560.",
    "token_id_ordering_looks_transposed_and_is_not": "eos_token_id is 1 and bos_token_id is 2."
  }
}
