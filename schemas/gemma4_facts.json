{
  "contract": "gemma4_facts",
  "description": "Gemma 4 architecture facts: the values rust-harness, interp, and training each hold private copies of. Derived from the pinned config.json revisions below, not from the committed header transcripts, so transcript-versus-contract is a real cross-check rather than a restatement.",
  "facts_version": 1,
  "writers": [
    "google/gemma-4-* config.json at the revisions in \"revisions\" (the upstream authority)",
    "scripts/models/gemma4_header_transcript.sh -> docs/models/gemma4-safetensors.txt",
    "scripts/models/gguf_header_transcript.sh -> docs/models/gemma4-gguf.txt",
    "docs/models/gemma-4.md (the prose restatement)"
  ],
  "readers": [
    "rust-harness/runtime/src/model/cpu.rs (Config, GGUF key reads, layer schedule, rope)",
    "rust-harness/runtime/src/gguf.rs (gemma4.* metadata keys)",
    "rust-harness/runtime/src/synth.rs (gemma4.* keys written by the fixture writer)",
    "rust-harness/fixtures/reference_logits.py (independent Python reader of the same keys)",
    "training/calculator/components.py (explicit_head_dim, parameter accounting)",
    "training/models/families.py (model_type gemma4 / gemma4_text registry)",
    "training/tune/distill.py (final_logit_softcapping)",
    "interp (reads width via residual_width(config); no hardcoded copy)",
    "tests/models/specbuild.py (structure-preserving scaled-down analogue)"
  ],
  "guarded_by": [
    "tests/models/test_gemma4_facts_contract.py",
    "tests/models/test_gemma4_header_transcript.py",
    "tests/models/test_gguf_header_transcript.py"
  ],
  "revisions": {
