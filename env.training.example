# Secrets template for docker-compose.training.yaml (training Phase 0 D6)
# Copy to .env.training (cp env.training.example .env.training) and fill in. The
# file is gitignored and passed via compose env_file; it is optional. Nothing is
# baked into the training image.

# Hugging Face token for gated base models (leave empty for public models)
HF_TOKEN=

# Weights & Biases API key; only needed when syncing offline runs (wandb sync)
WANDB_API_KEY=

# wandb runs offline by default (the box may be network-isolated during runs);
# set to "online" only for a connected run
WANDB_MODE=offline

# mlflow logs to a local file store under the run directory unless this is set
# MLFLOW_TRACKING_URI=

# LD_PRELOAD inside the training container (e.g. the huge-page mmap wrapper);
# empty by default
# TRAIN_LD_PRELOAD=

# RAM-disk shard staging size in GB (docker-compose.training.yaml tmpfs;
# default 32, sized to match staging.max_gb in the recipe)
# TRAIN_STAGING_GB=32
