# Environment configuration template for docker-compose.inference.yaml
# Copy to .env (cp env.example .env) and set model paths before `make up`.
# Paths are container paths under /app/models (host: /mnt/ai-data/models).

# llama-cpu model (either variable works; LLAMA_CPU_MODEL takes precedence)
LLAMA_ZEN5_MODEL=/app/models/example-model-Q4_K_M.gguf
# LLAMA_CPU_MODEL=/app/models/example-model-Q4_K_M.gguf

# llama-gpu model
LLAMA_GPU_MODEL=/app/models/example-model-Q4_K_M.gguf

# vllm-gpu model directory (HuggingFace format). Required: the vllm-gpu
# entrypoint fails fast when MODEL_PATH is empty.
VLLM_GPU_MODEL=/app/models/example-model-hf

# Nsight Systems profiling for GPU services (default: disabled)
# NSYS_PROFILE=false
# NSYS_OUTPUT=/app/nsys_output/profile

# Control-vector steering (interp W1). Read by the rust harness serving
# service in docker-compose.rust-harness.yaml, not by the llama services:
# R10 retired llama.cpp steering. Managed by `make steer-up` and
# `make steer-down`; set manually only for debugging.
# CONTROL_VECTOR=
# CONTROL_VECTOR_SCALE=
# CONTROL_VECTOR_LAYER_RANGE=
# HARNESS_MODEL=/app/models/hf/gemma-4-E4B-it

# Host user mapping for llama-gpu volume writes (defaults: 1000)
# UID=1000
# GID=1000
