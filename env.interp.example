# Secrets template for docker-compose.interp.yaml (interp Phase 0 I1)
# Copy to .env.interp (cp env.interp.example .env.interp) and fill in. The file is
# gitignored and passed via compose env_file; it is optional, but smoke-test step 6
# (gated Gemma-2-2B + Gemma Scope) skips with a warning until HF_TOKEN is set.

# Hugging Face token with the Gemma license accepted (https://huggingface.co/google/gemma-2-2b)
HF_TOKEN=

# Optional: used only by the Neuronpedia webapp for explanation-search embeddings (PS2);
# the platform runs without it. Copied into the checkout by scripts/interp/np_env.sh.
OPENAI_API_KEY=
